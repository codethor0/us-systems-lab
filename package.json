{
  "name": "us-systems-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check:emoji": "python3 scripts/check-no-emoji.py",
    "test:scripts": "python3 -B -m unittest discover -s scripts -p 'test_*.py'",
    "verify": "npm run lint && npm run typecheck && npm run format:check && npm run coverage && npm run build && npm run test:scripts && npm run check:emoji && npm run check:attribution && npm run test:math",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "npm run build && npm run test:math && node scripts/block-e2e.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "test:math": "node scripts/model-audit.mjs",
    "check:attribution": "python3 scripts/check-attribution.py"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "packageManager": "npm@10.9.2"
}
